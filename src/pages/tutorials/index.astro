---
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorials', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Tutorials — Ali Elgin</title>
	</head>
	<body>
		<h1>Tutorials</h1>
		<ul>
			{tutorials.map((a) => (
				<li>
					<a href={`/tutorials/${a.id}/`}>{a.data.title}</a>
					<time datetime={a.data.date.toISOString()}>{a.data.date.toLocaleDateString('en-GB', { dateStyle: 'medium' })}</time>
					<p>{a.data.description}</p>
				</li>
			))}
		</ul>
	</body>
</html>
