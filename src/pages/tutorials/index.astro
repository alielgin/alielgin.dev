---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorials', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Tutorials: Ali Elgin" description="Every tutorial, newest first. Each one has a video, a written version, and working code.">
	<h1>Tutorials</h1>
	<ul class="plain">
		{tutorials.map((t) => (
			<li>
				<a href={`/tutorials/${t.id}/`}>{t.data.title}</a>
				<br /><time datetime={t.data.date.toISOString()}>{t.data.date.toLocaleDateString('en-GB', { dateStyle: 'medium' })}</time>
				<p>{t.data.description}</p>
			</li>
		))}
	</ul>
</Base>
