---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const tutorials = await getCollection('tutorials', ({ data }) => !data.draft);
  return tutorials.map((tutorial) => ({ params: { id: tutorial.id }, props: { tutorial } }));
}

const { tutorial } = Astro.props;
const { Content } = await render(tutorial);
---

<Base title={`${tutorial.data.title}: Ali Elgin`} description={tutorial.data.description} ogImage={tutorial.data.cover}>
	<article>
		<h1>{tutorial.data.title}</h1>
		<p>{tutorial.data.description}</p>
		<time datetime={tutorial.data.date.toISOString()}>{tutorial.data.date.toLocaleDateString('en-GB', { dateStyle: 'medium' })}</time>
		{tutorial.data.cover && <img src={tutorial.data.cover} alt="" />}
		<Content />
	</article>
	<p><a href="/tutorials/">All tutorials</a></p>
</Base>
