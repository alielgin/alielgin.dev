---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const tutorials = await getCollection('tutorials', ({ data }) => !data.draft);
  return tutorials.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{article.data.title} — Ali Elgin</title>
		<meta name="description" content={article.data.description} />
		{article.data.cover && <meta property="og:image" content={article.data.cover} />}
	</head>
	<body>
		<a href="/tutorials/">← Tutorials</a>
		<article>
			<h1>{article.data.title}</h1>
			<time datetime={article.data.date.toISOString()}>{article.data.date.toLocaleDateString('en-GB', { dateStyle: 'medium' })}</time>
			{article.data.cover && <img src={article.data.cover} alt="" />}
			<Content />
		</article>
	</body>
</html>
