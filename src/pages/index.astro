---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorials', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
	title="Ali Elgin: engineer and developer educator"
	description="Tutorials, videos, and working code from a senior engineer with 21 years of shipping software. Storybook, visual testing, Cloudflare, Apple Watch, and more."
>
	<h1>Ali Elgin</h1>
	<p>Senior engineer. I build developer tools and products, and teach what I learn shipping them.</p>
	<p class="links">
		<a rel="me" href="https://github.com/alielgin">GitHub</a>
		<a rel="me" href="https://www.linkedin.com/in/ali-elgin-a43364a9/">LinkedIn</a>
		<a href="mailto:ali@alielgin.dev">ali@alielgin.dev</a>
	</p>

	<h2>Tutorials</h2>
	<ul class="plain">
		{tutorials.map((t) => (
			<li>
				<a href={`/tutorials/${t.id}/`}>{t.data.title}</a><br />
				<span class="meta">{t.data.description}</span>
			</li>
		))}
	</ul>

</Base>
