---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorials', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
	title="Ali Elgin: engineer and developer educator"
	description="Tutorials, videos, and working code from a senior engineer with 21 years of shipping software. Storybook, visual testing, Cloudflare, Apple Watch, and more."
>
	<h1>Ali Elgin</h1>
	<p>Senior engineer. I build developer tools and products, and teach what I learn shipping them.</p>
	<p class="links">
		<a rel="me" href="https://github.com/alielgin">GitHub</a>
		<a rel="me" href="https://www.linkedin.com/in/alielgin/">LinkedIn</a>
		<a href="mailto:ali@alielgin.dev">ali@alielgin.dev</a>
	</p>

	<h2>Tutorials</h2>
	<ul class="plain">
		{tutorials.map((t) => (
			<li>
				<a href={`/tutorials/${t.id}/`}>{t.data.title}</a><br />
				<span class="meta">{t.data.description}</span>
			</li>
		))}
	</ul>

	<h2>Things I've shipped</h2>
	<ul class="plain">
		<li><strong>FlightDial</strong><br /><span class="meta">Live aircraft on an Apple Watch dial, placed where they really are in the sky.</span></li>
		<li><strong>Trivia Gorilla</strong><br /><span class="meta">A daily quiz app for iPhone and Android, running on Cloudflare.</span></li>
		<li><strong><a href="https://enflasyonkac.com">enflasyonkac.com</a></strong><br /><span class="meta">Turkey's inflation figures and calculators, live minutes after each release.</span></li>
		<li><strong>NOTAM mapping platform</strong><br /><span class="meta">Aviation notices on a map, in daily use at a civil aviation authority.</span></li>
	</ul>
</Base>
